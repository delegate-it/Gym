# Neon Postgres. `neon deploy` / `neon env pull` fill these in for you.
# DATABASE_URL: pooled connection (host contains "-pooler"), used by the app.
# DATABASE_URL_UNPOOLED: direct connection, used by Prisma migrations.
# Local Postgres example: set both to postgresql://postgres:postgres@localhost:5432/gym
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Used to hash login codes and sessions. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me"

# SMTP for sending login codes, e.g. SendGrid (host smtp.sendgrid.net, port 587, user "apikey", password = API key). If unset in development, the code is printed
# to the server console and shown on the sign-in screen.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Gym <no-reply@example.com>"

# Where exercise images are loaded from. Run `npm run images` to self-host them
# and then set this to "/exercise-images".
NEXT_PUBLIC_EXERCISE_IMAGE_BASE="https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises"
