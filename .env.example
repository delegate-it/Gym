# SQLite for local use. For production use Postgres: change `provider` in prisma/schema.prisma
# to "postgresql" and set e.g. DATABASE_URL="postgresql://user:pass@host:5432/gym"
DATABASE_URL="file:./dev.db"

# Used to hash login codes and sessions. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me"

# SMTP for sending login codes. If unset in development, the code is printed
# to the server console and shown on the sign-in screen.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Gym <no-reply@example.com>"

# Where exercise images are loaded from. Run `npm run images` to self-host them
# and then set this to "/exercise-images".
NEXT_PUBLIC_EXERCISE_IMAGE_BASE="https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises"
